# Keys are read only from environment/.env. Empty keys are allowed at startup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Legacy publishing library only. Ignored/not required by staging; leave empty.
BINANCE_SQUARE_API_KEY=

# Staging: never send real posts. CLI, backend and Compose force this to false.
AUTO_PUBLISH=false

# SQLite only. Relative path for local use; Compose maps /app/data to a volume.
DATABASE_URL=sqlite:///data/bot.db

HOST=127.0.0.1
PORT=8080
# Optional on loopback; required for a standalone bind to a public interface.
# Browser: username admin, password ADMIN_TOKEN. APIs accept Bearer auth as well.
ADMIN_TOKEN=
ALLOW_UNAUTHENTICATED_ADMIN=false

COLLECT_ENABLED=true
COLLECTION_INTERVAL_SEC=900
SCHEDULER_INTERVAL_SEC=60
MARKET_SYMBOLS=BTCUSDT,ETHUSDT

EVENT_MIN_SCORE=40
EVENT_MAX_AGE_SEC=86400
EVENT_MAX_ATTEMPTS=3
MAX_DRAFTS_PER_CYCLE=3
MAX_DRAFTS_PER_DAY=10
MAX_AI_REQUESTS_PER_DAY=40

WRITER_MAX_CHARS=650
WRITER_PROMPT_PATH=prompts/writer.txt

HTTP_TIMEOUT_SEC=30
HTTP_MAX_ATTEMPTS=3
# Readiness requires a successful Binance Spot observation within this many seconds.
READINESS_MAX_AGE_SEC=3600
MEDIA_ROOT=data/media

# Preserved queue policies: 5 min -> x2 -> max 6 h, then dead letter.
BINANCE_MAX_ATTEMPTS=6
BINANCE_BACKOFF_BASE_SEC=300
BINANCE_BACKOFF_MAX_SEC=21600
BINANCE_PUBLISHED_TTL_DAYS=30
BINANCE_IMAGE_FALLBACK_TEXT=0
HISTORY_LIMIT=500

# Opt-in only. Default tests/CI must never call real providers or public data.
RUN_LIVE_TESTS=false
